@prefix : <http://example.org/pokemon-ontology#> .
@prefix poke: <https://pokemonkg.org/ontology#> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:PokemonAnatomyOntology a owl:Ontology ;
    rdfs:comment "An ontology describing the anatomical features of Pokémon."@en ;
    rdfs:label "Pokémon Anatomy Ontology"@en ;
    owl:versionInfo "1.0" .

:BodyPart a owl:Class ;
    rdfs:label "body part"@en ;
    rdfs:comment "An anatomical feature of a Pokémon."@en .

:structuralPartOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "structural part of"@en ;
    rdfs:comment "Indicates that one anatomical feature is a structural part of another."@en ;
    rdfs:domain :BodyPart ;
    rdfs:range :BodyPart .

:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:comment "Relates a pokemon to its attributes."@en ;
    rdfs:domain poke:Species ;
    rdfs:range :BodyPart .

:hasColour a owl:ObjectProperty ;
    rdfs:label "has colour"@en ;
    rdfs:comment "Relates a pokemon to its colour."@en ;
    rdfs:domain  poke:Species ;
    rdfs:range owl:Thing .

# 0 - Main Body

:MainBody rdf:type :BodyPart ;
    rdfs:label "main body"@en ;
    rdfs:comment "The main body of a Pokémon."@en .

# 1 - Main Body Parts

:Head rdf:type :BodyPart ;
    rdfs:label "head"@en ;
    rdfs:comment "The head of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Body rdf:type :BodyPart ;
    rdfs:label "body"@en ;
    rdfs:comment "The body of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Flame rdf:type :BodyPart ;
    rdfs:label "flame"@en ;
    rdfs:comment "The flame of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Leaf rdf:type :BodyPart ;
    rdfs:label "leaf"@en ;
    rdfs:comment "The leaf of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Vines rdf:type :BodyPart ;
    rdfs:label "vines"@en ;
    rdfs:comment "The vines of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Flower rdf:type :BodyPart ;
    rdfs:label "flower"@en ;
    rdfs:comment "The flower of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Mushroom rdf:type :BodyPart ;
    rdfs:label "mushroom"@en ;
    rdfs:comment "The mushroom of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Chrysalis  rdf:type :BodyPart ;
    rdfs:label "chrysalis"@en ;
    rdfs:comment "The chrysalis of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Hair rdf:type :BodyPart ;
    rdfs:label "hair"@en ;
    rdfs:comment "The hair of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Mane rdf:type :BodyPart ;
    rdfs:label "mane"@en ;
    rdfs:comment "The mane of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:BodyShell rdf:type :BodyPart ;
    rdfs:label "body shell"@en ;
    rdfs:comment "The body shell of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:BodyRoughness rdf:type :BodyPart ;
    rdfs:label "body roughness"@en ;
    rdfs:comment "The body roughness of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:BodySymbols rdf:type :BodyPart ;
    rdfs:label "body symbols"@en ;
    rdfs:comment "The body symbols/patterns of a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Item rdf:type :BodyPart ;
    rdfs:label "item"@en ;
    rdfs:comment "The item(s) held by or on a Pokémon."@en ;
    :structuralPartOf :MainBody .

:Gem rdf:type :BodyPart ;
    rdfs:label "gem"@en ;
    rdfs:comment "The gem(s) of a Pokémon."@en ;
    :structuralPartOf :MainBody .

